# Copy to .env  (cp .env.example .env) and fill in.
DATABASE_URL="file:./dev.db"

# 64 hex chars (32 bytes). Generate:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PHONE_ENC_KEY="d1763fadb8dc28f38a1f2f9fed9cc53c200d58ea521833849f14af23384e82a5"

# "open"   -> no tokens required (matches the current UI, which has no login). Dev only.
# "strict" -> donor/seeker bearer tokens are enforced on every write. Use in production.
AUTH_MODE="open"

# Comma-separated browser origins allowed to call the API (empty = same-origin only)
CORS_ORIGINS=""
